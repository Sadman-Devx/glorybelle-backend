# =============================================================================
# GLORYBELLE — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
# =============================================================================

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
# Include localhost: the container healthcheck calls http://localhost:8000/health/
ALLOWED_HOSTS=localhost,127.0.0.1

# Docker image runs config.settings.production by default (set in Dockerfile).
# Running over plain http://localhost with docker compose? Uncomment:
# SECURE_SSL_REDIRECT=False

# P1 fix #10 — Frontend URL (used for password-reset email link)
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL) — the ONLY supported database (no SQLite fallback)
# POSTGRES_* configure the `db` container in docker-compose.yml and MUST match
# DATABASE_URL below. Use a strong password in production.
# Note: Postgres only reads POSTGRES_PASSWORD when the data volume is first
# created; to change it later, change it inside Postgres too (or recreate the
# volume with `docker compose down -v` — this DELETES the data).
# -----------------------------------------------------------------------------
POSTGRES_DB=glorybelle
POSTGRES_USER=glorybelle
POSTGRES_PASSWORD=glorybelle
# For Django running on your host machine (localhost). Inside docker compose,
# DATABASE_URL is overridden automatically to point at the `db` container.
DATABASE_URL=postgres://glorybelle:glorybelle@localhost:5432/glorybelle

# Redis (cache + sessions + Celery broker)
REDIS_URL=redis://localhost:6379/0

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Fattura24 (Italian e-invoicing)
FATTURA24_API_KEY=your-fattura24-api-key
# P1 fix #15 — Fattura24 document template ID (configured in Fattura24 dashboard)
FATTURA24_TEMPLATE_ID=

# SendGrid (transactional email)
SENDGRID_API_KEY=SG.your-sendgrid-api-key

# Cloudinary (media storage) — P1 fix #12 (3 separate vars instead of 1 URL)
# Production uses Cloudinary only when CLOUDINARY_CLOUD_NAME is set; otherwise
# uploads go to the local `media_files` Docker volume.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Sentry (error tracking — production only)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
