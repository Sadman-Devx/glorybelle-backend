# =============================================================================
# GLORYBELLE — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.
# =============================================================================

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DATABASE_URL=postgres://glorybelle:glorybelle@localhost:5432/glorybelle

# Redis (cache + sessions + Celery broker)
REDIS_URL=redis://localhost:6379/0

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Fattura24 (Italian e-invoicing)
FATTURA24_API_KEY=your-fattura24-api-key

# SendGrid (transactional email)
SENDGRID_API_KEY=SG.your-sendgrid-api-key

# Cloudinary (media storage)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Sentry (error tracking — production only)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000
