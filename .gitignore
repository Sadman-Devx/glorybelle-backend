# =============================================================================
# GLORYBELLE — .gitignore
# =============================================================================

# Environment & Secrets
.env
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
eggs/
*.egg

# Virtual environment
.venv/
venv/
ENV/

# Django
*.log
local_settings.py
# All SQLite databases — covers db.sqlite3, db_test.sqlite3, db_dev.sqlite3, etc.
# (P0 fix #5 — db_test.sqlite3 was previously committed because only the exact
# name "db.sqlite3" was ignored. Wildcard catches every .sqlite3 variant.)
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
media/
staticfiles/
static_collected/
# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/

# Docker
postgres_data/

# Node (if any frontend tooling)
node_modules/
